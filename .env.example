ADMIN_BOT_TOKEN=your_admin_bot_token
ADMIN_IDS=123456789
DATABASE_URL=sqlite+aiosqlite:///data/app.db

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AI_TOPIC_PROMPT='Определи основную тему Telegram-поста. Ответь строго JSON: {"topic":"краткая тема до 5 слов","confidence":0.0,"reason":"почему выбрана тема до 12 слов"}'

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_NAME=comments_ai_bot

APP_ENV=local
LOG_LEVEL=INFO

TGSTAT_IMPORT_TARGET_CHANNELS=10000
TGSTAT_IMPORT_MAX_PAGES=5
TGSTAT_IMPORT_MAX_CHANNELS=30000
TGSTAT_IMPORT_CONCURRENCY=8
TGSTAT_VALIDATE_CHANNELS=false
